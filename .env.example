# Copy to .env.local for local development.
# In production these live in Vercel → Project Settings → Environment Variables.
# .env.local is gitignored; never commit a real password.

# Required to unlock the Payments section.
PAYMENTS_PASSWORD=choose-something-here

# Optional overrides — the code already defaults to the trip's sheet.
# SHEET_PUB_ID=2PACX-...
# SHEET_ID=15kWHs1zXOvSkIj7s0QcbhcN4de0_bbMuNAE1hZ3VWvA
# SHEET_REVALIDATE=300
# SITE_URL=https://your-app.vercel.app
